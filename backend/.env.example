# Copy to backend/.env for local development. Replace placeholders locally.
# Never commit real credentials. Do not expose privileged values in VITE_* variables.
QUEME_DATABASE_URL=postgresql://queme:REPLACE_ME@localhost:5432/queme
QUEME_INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_SERVER_ONLY_TOKEN
QUEME_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
QUEME_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Server only: use for admin creation and signed recording URLs; never expose it to Vite.
QUEME_SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_KEY
QUEME_BOOTSTRAP_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
QUEME_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
QUEME_DATABASE_CONNECT_TIMEOUT_SECONDS=2
QUEME_AUDIO_JOB_MAX_ATTEMPTS=4
QUEME_AUDIO_JOB_TIMEOUT_SECONDS=300
QUEME_AUDIO_JOB_LEASE_SECONDS=360
QUEME_AUDIO_WORKER_POLL_SECONDS=1
