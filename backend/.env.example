# Flask application and local SQLite database
FLASK_ENV=development
FLASK_APP=queme
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Omit DATABASE_URL to use backend/queme.db, or set a sqlite:/// URL for a custom file.

# Local interview intelligence
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=4096

# S3 object storage. Add the AWS keys before submitting audio.
STORAGE_BACKEND=s3
STORAGE_LOCAL_DIR=uploads
S3_BUCKET_NAME=queme-audio
S3_REGION=ap-southeast-2
AWS_REGION=ap-southeast-2
S3_ENDPOINT_URL=
S3_ADDRESSING_STYLE=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Alternatively, omit the key values and use an AWS profile or attached IAM role.

# Speech transcription
WHISPER_MODEL=base

# Optional Cloudflare R2 settings (used only with STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=via-interview-audio

# Admin bootstrap and frontend
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=QueMe Administrator
FRONTEND_ORIGIN=http://localhost:5173
JWT_EXP_HOURS=24

# Optional password-reset email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
